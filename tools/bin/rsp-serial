#!/usr/bin/env python3
"""Run a shell command on the ReSpeaker over its USB serial console.
usage: rsp-serial [-t SECONDS] 'command'   (logs in as respeaker if needed)"""
import os, sys, termios, time, select, re, uuid

DEV = os.environ.get("RSP_TTY", "/dev/ttyACM0")
# Seeed's vendor image ships with user and password both "respeaker" (public default).
# Set RSP_SERIAL_USER / RSP_SERIAL_PASSWORD if yours were changed.
VENDOR_DEFAULT = "respeaker"
USER = os.environ.get("RSP_SERIAL_USER", VENDOR_DEFAULT)
PW = os.environ.get("RSP_SERIAL_PASSWORD", VENDOR_DEFAULT)

def main():
    args = sys.argv[1:]
    timeout = 30.0
    if args and args[0] == "-t":
        timeout = float(args[1]); args = args[2:]
    cmd = " ".join(args)
    fd = os.open(DEV, os.O_RDWR | os.O_NOCTTY | os.O_NONBLOCK)
    a = termios.tcgetattr(fd)
    a[0] = 0; a[1] = 0; a[3] = 0
    a[2] = termios.CS8 | termios.CREAD | termios.CLOCAL
    a[4] = a[5] = termios.B115200
    termios.tcsetattr(fd, termios.TCSANOW, a)

    def read_until(pat, t):
        buf = b""; end = time.time() + t
        while time.time() < end:
            r, _, _ = select.select([fd], [], [], 0.2)
            if r:
                try: buf += os.read(fd, 65536)
                except BlockingIOError: pass
                if re.search(pat, buf): return buf, True
        return buf, False
    def send(s): os.write(fd, s.encode())

    send("\r")
    buf, _ = read_until(rb"login: ?$|[$#] ?$|Password: ?$", 5)
    if re.search(rb"Password: ?$", buf):
        send("\r"); buf, _ = read_until(rb"login: ?$", 8)
    if re.search(rb"login: ?$", buf):
        send(USER + "\r"); read_until(rb"Password: ?$", 8)
        send(PW + "\r"); buf, ok = read_until(rb"[$#] ?$", 15)
        if not ok:
            sys.stderr.write("login failed:\n" + buf.decode(errors="replace")); sys.exit(2)
    tag = uuid.uuid4().hex[:12]
    send("stty -echo; PS1=; PS2=; echo B''%s; %s; echo; echo E''%s:$?\r" % (tag, cmd, tag))
    buf, ok = read_until(("E%s:\\d+" % tag).encode(), timeout)
    txt = buf.decode(errors="replace").replace("\r", "")
    m = re.search("B%s\n(.*?)\n?E%s:(\\d+)" % (tag, tag), txt, re.S)
    send("stty echo; PS1='\\u@\\h:\\w\\$ '\r")
    time.sleep(0.2)
    if not m:
        sys.stderr.write("timeout/garbled:\n" + txt); sys.exit(3)
    sys.stdout.write(m.group(1).rstrip("\n") + "\n")
    sys.exit(int(m.group(2)))
main()

From c2c88b70b7d3fe35ffd56e0f711ef3f2fbfb043f Mon Sep 17 00:00:00 2001
From: Heath Albritton <10265718+halbritt@users.noreply.github.com>
Date: Mon, 16 Nov 2026 23:37:05 -0800
Subject: [PATCH] snk_tracks: replace overlapping sprintf with bounded
 vsnprintf

Replace overlapping sprintf(obj->buffer, "%s...", obj->buffer) calls in snk_tracks_process_format_text_json() with an offset-tracked vsnprintf helper bounded to the 1024-byte buffer capacity.
---
 src/sink/snk_tracks.c | 63 ++++++++++++++++++++++++++++++++-----------
 1 file changed, 48 insertions(+), 15 deletions(-)

diff --git a/src/sink/snk_tracks.c b/src/sink/snk_tracks.c
index b92eb46..659026d 100644
--- a/src/sink/snk_tracks.c
+++ b/src/sink/snk_tracks.c
@@ -27,8 +27,39 @@
     *
     */
     
+    #include <stdarg.h>
     #include <sink/snk_tracks.h>
 
+    #define SNK_TRACKS_BUFFER_CAPACITY 1024
+
+    static void snk_tracks_appendf(char * buffer, size_t capacity, size_t * offset, const char * fmt, ...) {
+
+        va_list args;
+        size_t remaining;
+        int written;
+
+        if (*offset >= capacity - 1) {
+            return;
+        }
+
+        remaining = capacity - *offset;
+        va_start(args, fmt);
+        written = vsnprintf(buffer + *offset, remaining, fmt, args);
+        va_end(args);
+
+        if (written < 0) {
+            return;
+        }
+
+        if ((size_t) written >= remaining) {
+            *offset = capacity - 1;
+        }
+        else {
+            *offset += (size_t) written;
+        }
+
+    }
+
     snk_tracks_obj * snk_tracks_construct(const snk_tracks_cfg * snk_tracks_config, const msg_tracks_cfg * msg_tracks_config) {
 
         snk_tracks_obj * obj;
@@ -58,8 +89,8 @@
 
         obj->fp = (FILE *) NULL;
 
-        obj->buffer = (char *) malloc(sizeof(char) * 1024);
-        memset(obj->buffer, 0x00, sizeof(char) * 1024);
+        obj->buffer = (char *) malloc(sizeof(char) * SNK_TRACKS_BUFFER_CAPACITY);
+        memset(obj->buffer, 0x00, sizeof(char) * SNK_TRACKS_BUFFER_CAPACITY);
         obj->bufferSize = 0;
 
         obj->in = (msg_tracks_obj *) NULL;
@@ -341,38 +372,40 @@
     void snk_tracks_process_format_text_json(snk_tracks_obj * obj) {
 
         unsigned int iTrack;
+        size_t offset;
 
+        offset = 0;
         obj->buffer[0] = 0x00;
 
-        sprintf(obj->buffer,"%s{\n",obj->buffer);
-        sprintf(obj->buffer,"%s    \"timeStamp\": %llu,\n",obj->buffer,obj->in->timeStamp);
-        sprintf(obj->buffer,"%s    \"src\": [\n",obj->buffer);
+        snk_tracks_appendf(obj->buffer, SNK_TRACKS_BUFFER_CAPACITY, &offset, "{\n");
+        snk_tracks_appendf(obj->buffer, SNK_TRACKS_BUFFER_CAPACITY, &offset, "    \"timeStamp\": %llu,\n", obj->in->timeStamp);
+        snk_tracks_appendf(obj->buffer, SNK_TRACKS_BUFFER_CAPACITY, &offset, "    \"src\": [\n");
 
         for (iTrack = 0; iTrack < obj->nTracks; iTrack++) {
 
-            sprintf(obj->buffer,"%s        { \"id\": %llu, \"tag\": \"%s\", \"x\": %1.3f, \"y\": %1.3f, \"z\": %1.3f, \"activity\": %1.3f }", 
-                    obj->buffer,
+            snk_tracks_appendf(obj->buffer, SNK_TRACKS_BUFFER_CAPACITY, &offset,
+                    "        { \"id\": %llu, \"tag\": \"%s\", \"x\": %1.3f, \"y\": %1.3f, \"z\": %1.3f, \"activity\": %1.3f }",
                     obj->in->tracks->ids[iTrack],
                     obj->in->tracks->tags[iTrack],
-                    obj->in->tracks->array[iTrack*3+0], 
-                    obj->in->tracks->array[iTrack*3+1], 
+                    obj->in->tracks->array[iTrack*3+0],
+                    obj->in->tracks->array[iTrack*3+1],
                     obj->in->tracks->array[iTrack*3+2],
                     obj->in->tracks->activity[iTrack]);
 
             if (iTrack != (obj->nTracks - 1)) {
 
-                sprintf(obj->buffer,"%s,",obj->buffer);
+                snk_tracks_appendf(obj->buffer, SNK_TRACKS_BUFFER_CAPACITY, &offset, ",");
 
             }
 
-            sprintf(obj->buffer,"%s\n",obj->buffer);
+            snk_tracks_appendf(obj->buffer, SNK_TRACKS_BUFFER_CAPACITY, &offset, "\n");
 
         }
-        
-        sprintf(obj->buffer,"%s    ]\n",obj->buffer);
-        sprintf(obj->buffer,"%s}\n",obj->buffer);
 
-        obj->bufferSize = strlen(obj->buffer);
+        snk_tracks_appendf(obj->buffer, SNK_TRACKS_BUFFER_CAPACITY, &offset, "    ]\n");
+        snk_tracks_appendf(obj->buffer, SNK_TRACKS_BUFFER_CAPACITY, &offset, "}\n");
+
+        obj->bufferSize = (unsigned int) offset;
 
     }
 

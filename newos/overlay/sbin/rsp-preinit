#!/bin/sh
# Boot safety net, run as init= before systemd.
#  - bringup (default): keeps a copy of the kernel log on disk for the first minutes of every boot
#    and runs a dead-man switch (disarms /boot/uEnv.txt and resets to eMMC if /run/rsp-keep
#    does not appear within rsp_deadman seconds, default 300).
#  - release: skips /boot-debug polling and dead-man switch, hands /dev/watchdog to systemd if
#    RuntimeWatchdogSec is configured, and execs /sbin/init immediately.
if [ "${RSP_TEST_MODE:-0}" = "1" ]; then
	R=${RSP_ROOT:?}
	PATH=${RSP_TEST_PATH:?}:$PATH
	export PATH
	INIT_BIN=${RSP_INIT_BIN:-"$R/sbin/init"}
else
	R=""
	INIT_BIN=/sbin/init
fi

get_cmdline_opt() {
	_key=$1
	_val=""
	if [ -r "$R/proc/cmdline" ]; then
		for _tok in $(cat "$R/proc/cmdline"); do
			case "$_tok" in
				"$_key"=*) _val=${_tok#*=} ;;
			esac
		done
	fi
	printf '%s\n' "$_val"
}

resolve_safety_profile() {
	_sfile=$1
	_p=$(get_cmdline_opt rsp_safety)
	if [ -z "$_p" ] && [ -r "$_sfile" ]; then
		_p=$(sed -n 's/[[:space:]]*#.*//; /^[[:space:]]*$/d; s/^[[:space:]]*//; s/[[:space:]]*$//; p; q' "$_sfile" 2>/dev/null)
	fi
	case "$_p" in
		bringup|release)
			printf '%s\n' "$_p"
			;;
		"")
			printf '%s\n' "bringup"
			;;
		*)
			echo "rsp-safety: unknown profile '$_p', defaulting to bringup" >&2
			printf '%s\n' "bringup"
			;;
	esac
}

next_boot_id() {
	_dir=$1
	_max=-1
	for _d in "$_dir"/boot-*; do
		[ -d "$_d" ] || continue
		_n=${_d##*/boot-}
		case "$_n" in ""|*[!0-9]*) continue ;; esac
		while case "$_n" in 0[0-9]*) _n=${_n#0} ;; *) false ;; esac; do :; done
		[ "$_n" -gt "$_max" ] && _max=$_n
	done
	echo $((_max + 1))
}

prune_boot_debug() {
	_dir=$1
	_keep=${2:-20}
	_keep_crash=${3:-5}
	[ -d "$_dir" ] || return 0
	case "$_keep" in ""|*[!0-9]*) return 0 ;; esac
	case "$_keep_crash" in ""|*[!0-9]*) _keep_crash=5 ;; esac
	while case "$_keep" in 0[0-9]*) _keep=${_keep#0} ;; *) false ;; esac; do :; done
	while case "$_keep_crash" in 0[0-9]*) _keep_crash=${_keep_crash#0} ;; *) false ;; esac; do :; done
	[ "$_keep" -gt 0 ] || return 0

	_ncount=0
	_ccount=0
	for _d in "$_dir"/boot-*; do
		[ -d "$_d" ] || continue
		_n=${_d##*/boot-}
		case "$_n" in ""|*[!0-9]*) continue ;; esac
		if [ -d "$_d/pstore" ]; then
			_ccount=$((_ccount + 1))
		else
			_ncount=$((_ncount + 1))
		fi
	done

	while [ "$_ncount" -gt "$_keep" ]; do
		_min_val=""
		_min_dir=""
		for _d in "$_dir"/boot-*; do
			[ -d "$_d" ] || continue
			[ -d "$_d/pstore" ] && continue
			_n=${_d##*/boot-}
			case "$_n" in ""|*[!0-9]*) continue ;; esac
			while case "$_n" in 0[0-9]*) _n=${_n#0} ;; *) false ;; esac; do :; done
			if [ -z "$_min_val" ] || [ "$_n" -lt "$_min_val" ]; then
				_min_val=$_n
				_min_dir=$_d
			fi
		done
		[ -n "$_min_dir" ] || break
		rm -rf "$_min_dir"
		_ncount=$((_ncount - 1))
	done

	while [ "$_ccount" -gt "$_keep_crash" ]; do
		_min_val=""
		_min_dir=""
		for _d in "$_dir"/boot-*; do
			[ -d "$_d" ] || continue
			[ -d "$_d/pstore" ] || continue
			_n=${_d##*/boot-}
			case "$_n" in ""|*[!0-9]*) continue ;; esac
			while case "$_n" in 0[0-9]*) _n=${_n#0} ;; *) false ;; esac; do :; done
			if [ -z "$_min_val" ] || [ "$_n" -lt "$_min_val" ]; then
				_min_val=$_n
				_min_dir=$_d
			fi
		done
		[ -n "$_min_dir" ] || break
		rm -rf "$_min_dir"
		_ccount=$((_ccount - 1))
	done
}

has_systemd_watchdog() {
	_wval=""
	for _cfg in "$R/etc/systemd/system.conf" "$R/etc/systemd/system.conf.d/"*.conf; do
		[ -r "$_cfg" ] || continue
		_last=$(sed -n 's/[[:space:]]*#.*//; /^[[:space:]]*RuntimeWatchdogSec[[:space:]]*=/ { s/^[[:space:]]*RuntimeWatchdogSec[[:space:]]*=[[:space:]]*//; s/[[:space:]]*$//; s/^/set:/; h; }; $ { g; p; }' "$_cfg" 2>/dev/null)
		case "$_last" in
			set:*) _wval=${_last#set:} ;;
		esac
	done
	case "$_wval" in
		""|0|0[a-zA-Z]*|off|no|false) return 1 ;;
		[1-9]*) return 0 ;;
		*) return 1 ;;
	esac
}

D="$R/boot-debug"
SAFETY_PROFILE=$(resolve_safety_profile "$R/etc/rsp-safety")
KEEP_N=$(get_cmdline_opt rsp_debug_keep)
case "$KEEP_N" in
	""|*[!0-9]*)
		if [ "$SAFETY_PROFILE" = "release" ]; then KEEP_N=20; else KEEP_N=0; fi
		;;
esac

if [ "$SAFETY_PROFILE" = "bringup" ]; then
	mkdir -p "$D"
	n=$(next_boot_id "$D")
	B="$D/boot-$n"
	mkdir -p "$B"
	dmesg > "$B/dmesg-preinit.txt" 2>&1
	sync
	T=$(get_cmdline_opt rsp_deadman)
	case "$T" in ""|*[!0-9]*) T=300 ;; esac
	( i=0
	  while [ $i -lt 900 ]; do
	    dmesg > "$B/dmesg.new" 2>&1 && mv "$B/dmesg.new" "$B/dmesg.txt"
	    echo "$i $(cat "$R/proc/uptime" 2>/dev/null)" > "$B/alive.txt"
	    [ $((i % 10)) -eq 0 ] && sync
	    if [ "$T" -gt 0 ] && [ $i -ge "$T" ] && [ ! -e "$R/run/rsp-keep" ] && [ -e "$R/boot/uEnv.txt" ]; then
	      echo "deadman fired at $i" >> "$B/alive.txt"
	      journalctl -b --no-pager > "$B/journal.txt" 2>&1
	      mv "$R/boot/uEnv.txt" "$R/boot/uEnv.txt.done"; sync
	      echo rsp-clean-reboot >> "$R/dev/kmsg"; sleep 1
	      echo b > "$R/proc/sysrq-trigger"
	      exit 0
	    fi
	    i=$((i+1)); sleep 1
	  done ) </dev/null >/dev/null 2>&1 &
else
	if [ "$KEEP_N" -gt 0 ] && [ -d "$D" ]; then
		prune_boot_debug "$D" "$KEEP_N" 5
	fi
fi

if [ -r "$R/run/rsp-watchdog.pid" ] && has_systemd_watchdog; then
	_wpid=$(cat "$R/run/rsp-watchdog.pid" 2>/dev/null)
	case "$_wpid" in
		""|*[!0-9]*) ;;
		*) kill "$_wpid" 2>/dev/null || true ;;
	esac
	rm -f "$R/run/rsp-watchdog.pid"
fi

exec "$INIT_BIN" "$@"

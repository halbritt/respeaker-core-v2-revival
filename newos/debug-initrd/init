#!/bin/busybox sh
# Debug initramfs for the ReSpeaker Core v2 bring-up: runs entirely from RAM.
# LED state2: fast blink = userspace reached, slow blink = SD log written, heartbeat = USB console up.
/bin/busybox --install -s /bin
export PATH=/bin
mount -t proc proc /proc; mount -t sysfs sys /sys; mount -t devtmpfs dev /dev 2>/dev/null
exec >/dev/kmsg 2>&1 </dev/null
echo "rsp-debug-init: started, uptime $(cat /proc/uptime)"
L="/sys/class/leds/respeaker2:blue:state2"
led() { echo timer > "$L/trigger" 2>/dev/null; echo $1 > "$L/delay_on"; echo $1 > "$L/delay_off"; }
led 80
mkdir -p /cfg; mount -t configfs none /cfg 2>/dev/null
grep -q rspstay /proc/cmdline && touch /stay
BASECMD="rootwait rw earlycon console=ttyS2,115200n8 loglevel=7 printk.devkmsg=on log_buf_len=4M"

dump() {   # $1 = directory to write into
	dmesg > $1/dmesg.new && mv $1/dmesg.new $1/dmesg.txt
	echo "$2 $(cat /proc/uptime)" > $1/alive.txt
	cat /proc/cmdline > $1/cmdline.txt; cat /proc/device-tree/model > $1/model.txt 2>/dev/null; grep "^dtb=" /sd/boot/uEnv.txt > $1/dtb.txt 2>/dev/null
	ls -l /dev /sys/class/block /sys/class/leds /sys/class/net /sys/class/udc > $1/devs.txt 2>&1
	sync
}
sdlog() {
	i=0
	while [ $i -lt 30 ] && ! ls /dev/mmcblk*p2 >/dev/null 2>&1; do sleep 1; i=$((i+1)); done
	for p in /dev/mmcblk*p2; do
		mount -t ext4 $p /sd 2>/dev/null || continue
		[ -e /sd/sbin/rsp-preinit ] && break
		umount /sd
	done
	[ -e /sd/sbin/rsp-preinit ] || { echo "rsp-debug-init: SD root not found"; return 1; }
	n=$(ls /sd/boot-debug 2>/dev/null | grep -c '^boot-'); B=/sd/boot-debug/boot-$n; mkdir -p $B
	dump $B first && echo "rsp-debug-init: wrote $B"
	echo $B > /sdlogdir
}
sdlog && led 500

# Crash capture: the previous boot's kernel log survives a watchdog/panic reset in RAM (ramoops).
# If one is there, save it to the card, disarm the SD boot and return to the eMMC system.
mount -t pstore pstore /pstore 2>/dev/null
# a console log with a clean ending (and no panic record) is not a crash
crashed=0
ls /pstore/dmesg-* >/dev/null 2>&1 && crashed=1
# clean endings: our own marker, or the kernel's message for an ordinary reboot/poweroff
[ -e /pstore/console-ramoops-0 ] && ! tail -n 15 /pstore/console-ramoops-0 | grep -q \
	-e rsp-clean-reboot -e "reboot: Restarting system" -e "reboot: Power down" && crashed=1
[ $crashed = 0 ] && rm -f /pstore/* 2>/dev/null
if [ -s /sdlogdir ] && [ $crashed = 1 ]; then
	B=$(cat /sdlogdir); mkdir -p $B/pstore; cp /pstore/* $B/pstore/; rm -f /pstore/*
	echo "rsp-debug-init: saved previous boot log from pstore"; dump $B pstore
	if ! grep -q rspkeep /proc/cmdline; then
		mv /sd/boot/uEnv.txt /sd/boot/uEnv.txt.done; sync; umount /sd; { echo rsp-clean-reboot > /dev/kmsg; sleep 1; reboot -f; }
	fi
fi
# hardware watchdog: a frozen kernel resets the board after ~10 s
insmod /lib/dw_wdt.ko 2>&1 && [ -c /dev/watchdog ] && watchdog -T 10 -t 2 /dev/watchdog && echo "rsp-debug-init: watchdog armed"
# rspboot on the command line: continue into the real root filesystem on the card
if grep -q rspboot /proc/cmdline && [ -x /sd/sbin/rsp-preinit ]; then
	echo "rsp-debug-init: switching to the SD root"
	insmod /lib/g_serial.ko 2>/dev/null
	umount /pstore 2>/dev/null; umount /cfg 2>/dev/null
	mount --move /proc /sd/proc; mount --move /sys /sd/sys; mount --move /dev /sd/dev
	exec switch_root /sd /sbin/rsp-preinit
fi
grep -q rspcrash /proc/cmdline && { echo "rsp-debug-init: deliberate panic"; sync; sleep 1; echo c > /proc/sysrq-trigger; }
cat > /bin/ovl <<'EOT'
#!/bin/sh
# ovl <name>: apply /ov/<name>.dtbo; the name is recorded on the SD card first
B=$(cat /sdlogdir 2>/dev/null)
[ -n "$B" ] && { echo "$1 $(cat /proc/uptime)" >> $B/overlays.txt; dmesg > $B/dmesg-before-$1.txt; sync; }
mkdir /cfg/device-tree/overlays/$1 && cat /ov/$1.dtbo > /cfg/device-tree/overlays/$1/dtbo
echo "applied $1: $(cat /cfg/device-tree/overlays/$1/status 2>&1)"
EOT
chmod +x /bin/ovl

insmod /lib/g_serial.ko* && echo "rsp-debug-init: g_serial loaded"
( while :; do
	[ -c /dev/ttyGS0 ] && setsid sh -c 'exec sh -i </dev/ttyGS0 >/dev/ttyGS0 2>&1'
	sleep 1
  done ) &
sleep 1
# live kernel log to the USB host (it reads /dev/ttyACM0)
[ -c /dev/ttyGS0 ] && ( cat /dev/kmsg > /dev/ttyGS0 2>/dev/null & )
[ -c /dev/ttyGS0 ] && echo heartbeat > "$L/trigger"
i=0
while :; do
	[ -s /sdlogdir ] && dump "$(cat /sdlogdir)" $i
	# after ~50 s move on: next stage from /sd/boot/stages ("<dtb> <extra cmdline>" per line),
	# or hand the board back to the eMMC system when none is left. touch /stay to hold.
	if [ $i -ge 25 ] && [ ! -e /stay ] && [ -s /sdlogdir ]; then
		dump "$(cat /sdlogdir)" final
		next=$(head -n1 /sd/boot/stages 2>/dev/null)
		if [ -n "$next" ]; then
			sed -i 1d /sd/boot/stages
			set -- $next; d=$1; shift
			sed -i -e "s|^dtb=.*|dtb=$d|" -e "s|^cmdline=.*|cmdline=$BASECMD $*|" /sd/boot/uEnv.txt
			echo "$next" > "$(cat /sdlogdir)/next-stage.txt"
		else
			mv /sd/boot/uEnv.txt /sd/boot/uEnv.txt.done
		fi
		sync; umount /sd; { echo rsp-clean-reboot > /dev/kmsg; sleep 1; reboot -f; }
	fi
	i=$((i+1)); sleep 2
done

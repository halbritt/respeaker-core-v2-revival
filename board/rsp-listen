#!/usr/bin/env python3
"""rsp-listen - hand what the ReSpeaker hears to another program, e.g. an agent.

Reads the event stream of rsp-stt (GET /events, Server-Sent Events) and, for each utterance
that is addressed to the wake phrase, runs a command with the utterance as JSON on stdin and
the text in $RSP_TEXT (direction in $RSP_AZ, when known). Standard library only.

  rsp-listen --url http://127.0.0.1:8911/events --wake 'computer|hey board' -- ./my-agent
  rsp-listen --print                      # just show every event

After a wake phrase the next --follow seconds of speech are passed on too, so a
conversation does not need the phrase in every sentence. Without --wake everything is
passed on. The wake phrase is matched in the transcript text, so it costs nothing on the
board, but the reaction only comes once the utterance has been transcribed.
"""
import argparse, json, os, re, subprocess, sys, time, urllib.request

def events(url, token):
    """Yield (event, data) from an SSE stream, reconnecting when it drops."""
    while True:
        try:
            req = urllib.request.Request(url, headers={"Accept": "text/event-stream"})
            if token:
                req.add_header("Authorization", "Bearer " + token)
            with urllib.request.urlopen(req, timeout=60) as r:
                kind, data = None, []
                for line in r:
                    line = line.decode("utf-8", "replace").rstrip("\n")
                    if line.startswith("event:"):
                        kind = line[6:].strip()
                    elif line.startswith("data:"):
                        data.append(line[5:].strip())
                    elif not line and data:
                        yield kind, json.loads("\n".join(data))
                        kind, data = None, []
        except Exception as e:
            print("rsp-listen: stream lost (%s), reconnecting" % e, file=sys.stderr)
            time.sleep(3)

def main():
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--url", default=os.environ.get("RSP_EVENTS", "http://127.0.0.1:8911/events"))
    p.add_argument("--token", default=os.environ.get("RSP_TOKEN", ""))
    p.add_argument("--wake", help="regular expression that marks speech as addressed to the agent")
    p.add_argument("--follow", type=float, default=20, help="seconds after a wake phrase that still count")
    p.add_argument("--strip-wake", action="store_true", help="remove the wake phrase from the text passed on")
    p.add_argument("--print", action="store_true", dest="show", help="print events instead of running a command")
    p.add_argument("command", nargs=argparse.REMAINDER, help="-- command to run per utterance")
    a = p.parse_args()
    cmd = a.command[1:] if a.command[:1] == ["--"] else a.command
    wake = re.compile(a.wake, re.I) if a.wake else None
    awake_until = 0.0
    for kind, d in events(a.url, a.token):
        if a.show:
            print(kind, json.dumps(d), flush=True)
        if kind != "utterance":
            continue
        text, now = d.get("text", "").replace("\n", " ").strip(), time.time()
        if wake:
            hit = wake.search(text)
            if not hit and now > awake_until:
                continue
            awake_until = now + a.follow
            if hit and a.strip_wake:
                text = (text[:hit.start()] + text[hit.end():]).strip(" ,.!?") or text
        if not cmd:
            if not a.show:
                print(text, flush=True)
            continue
        env = dict(os.environ, RSP_TEXT=text, RSP_AZ=str(d.get("az", "")), RSP_TS=d.get("ts", ""))
        try:
            subprocess.run(cmd, input=json.dumps(dict(d, text=text)).encode(), env=env, timeout=300)
        except Exception as e:
            print("rsp-listen: command failed: %s" % e, file=sys.stderr)

if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        pass

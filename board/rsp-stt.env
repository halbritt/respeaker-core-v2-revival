# /etc/default/rsp-stt — settings for rsp-stt.service
# whisper.cpp server (whisper-server, POST /inference) on a machine with a GPU
STT_SERVER=http://whisper.example:8910/inference
STT_LANGUAGE=en
# sum = average of the six mics (favours sound arriving from above the board);
# or a single channel: 0-5 = microphones, 6-7 = playback loopback
STT_CHANNEL=sum
# Optional: POST each transcript as JSON {ts,text,audio_s,stt_s} to this URL
#STT_WEBHOOK=
# Pause that ends an utterance. Longer = bigger chunks with more context, later text.
STT_END_SILENCE_MS=1500
# Capture source: "arecord" (mics averaged) or "odas" (localise, track and beamform each
# talker; needs /opt/odas/odaslive and the cfg below; new OS only)
STT_SOURCE=odas
STT_ODAS_CFG=/opt/rsp-stt/odas-respeaker-core-v2.cfg
# odaslive options. "-s" (default) runs it in one thread: same transcripts for 42% less CPU,
# about 60% of one core. Set to nothing for odaslive's own threads.
#STT_ODAS_ARGS=-s
# Stream sent to Whisper: separated (plain beamformer; slightly better at utterance starts in
# an A/B on 2026-11-16), postfiltered, or both (logs the second as "text_pf")
STT_ODAS_SEND=separated
STT_DEBUG=0
# Directions to drop, "azimuth:halfwidth" in degrees (0 = USB-A side, counter-clockwise).
# The PC fan needed this at the desk; the board has since moved, so it is off.
#STT_ODAS_IGNORE=308:20
# Event stream for an agent or display: GET /events (Server-Sent Events) and /recent.
# 127.0.0.1 keeps it on the board (reach it with: ssh -L 8911:127.0.0.1:8911 <board>);
# use 0.0.0.0:8911 to let the LAN read what is said, ideally with STT_HTTP_TOKEN set.
STT_HTTP=127.0.0.1:8911
#STT_HTTP_TOKEN=
# Speech gate (Silero VAD): continuous speech an utterance must contain to be sent; 0 = off
STT_SPEECH_MIN_MS=200
# Echo cancellation: removes the board's own speaker from the microphones (0 = off).
# /opt/rsp-stt/rsp-aec does it when installed, a slower built-in one otherwise.
#STT_AEC=1
# Options for rsp-aec: "--highpass HZ" sets its hum filter (default 120, 0 = off);
# "--engine aec3" uses WebRTC AEC3 in place of Speex (removes the speaker more thoroughly,
# and a person talking over it too), with "--gentle N" (default 16) and "--linear".
# "--gain DB" raises the microphones after cancellation: the converters run at 14 dB
# (set at first boot) so the board's own speaker cannot clip them, and this restores the
# level a talker had at 24 dB. Keep it when adding other options.
STT_AEC_ARGS="--gain 10"
# Direction (degrees) the board's own speaker is heard from. A sound from here, or with no
# direction, is the board's own voice when STT_ECHO_SHARE (0.1) of it is what was played.
# A tracked sound from elsewhere is a person talking over the board: the board's words are
# taken out of its transcript; with STT_ECHO_SHARE_ELSEWHERE (0.5) or more played sound,
# STT_ECHO_WORDS (8) words must be left.
# 185 is the speaker on the board's own connector as measured; "drop: own speaker ... az="
# in the log shows it for another speaker. Empty = learn it from the clear cases.
STT_SPEAKER_AZ=185
# Sounds ODAS never tracked: shorter than this are dropped as noise, longer ones go to the
# speech gate (ODAS loses a talker for seconds at a time in a noisy room). 0 = drop them all.
#STT_UNTRACKED_MIN_MS=2000
# Level the ODAS stream must exceed to count as sound (plain microphone mode: STT_MIN_RMS,
# 150). Lower catches quieter speech in noise and sends more sounds to the speech gate.
#STT_ODAS_MIN_RMS=40
# How speech is found. "mic": on one microphone after the echo canceller, with ODAS only for
# the direction; it loses far fewer words (see README). "dominant": on ODAS's own streams,
# sending its beam; it stays silent when ODAS loses the talker. STT_MIC_CHANNEL picks the
# microphone (0).
STT_ODAS_MODE=mic

#!/bin/sh
# rsp-replay <recording.raw> [odaslive binary] - run a raw recording (rsp-record format)
# through ODAS and Whisper offline, without touching the live service or the sound card.
# Writes <recording>.transcript.jsonl next to the recording ("t" = seconds into the take).
# Settings come from /etc/default/rsp-stt, then /etc/default/rsp-stt.local (site overrides);
# override any STT_* variable in the environment. RSP_DEFAULTS_DIR replaces /etc/default.
# ODAS talks to the replay on its own ports, clear of the live service; change them with
# RSP_REPLAY_TRACK_PORT, RSP_REPLAY_AUDIO_PORT and RSP_REPLAY_SEP_PORT.
rec=$(readlink -f "$1"); out=${rec%.raw}.transcript.jsonl; rm -f "$out"
# the caller's STT_* settings, as quoted shell the script can replay after the defaults
keep=$(export -p | grep '^export STT_' || true)
etc=${RSP_DEFAULTS_DIR:-/etc/default}
set -a; . "$etc/rsp-stt"; [ -e "$etc/rsp-stt.local" ] && . "$etc/rsp-stt.local"; set +a
eval "$keep"
run=$(mktemp -d /tmp/rsp-replay-XXXXXX)
[ -n "$2" ] && export STT_ODAS_BIN="$2"
export STT_SOURCE=odas STT_ODAS_INPUT="$rec" STT_RUN_DIR="$run" STT_LOG="$out"
export STT_ODAS_TRACK_PORT="${RSP_REPLAY_TRACK_PORT:-9100}" STT_ODAS_AUDIO_PORT="${RSP_REPLAY_AUDIO_PORT:-9102}"
export STT_ODAS_SEP_PORT="${RSP_REPLAY_SEP_PORT:-9103}"
nice python3 -u "${RSP_STT:-/opt/rsp-stt/rsp-stt.py}" 2>&1 | grep -v '^\[\|^ '
rm -rf "$run"; touch "$out"; echo "wrote $out ($(wc -l < "$out") transcripts)"

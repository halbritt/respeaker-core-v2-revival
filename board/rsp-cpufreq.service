[Unit]
Description=ReSpeaker CPU frequency policy (stay at a low voltage unless a core is nearly full)
# Armbian sets the ondemand governor to jump to full speed at 25% load. The audio pipeline
# keeps one core about half busy, so the CPU sat at 1464 MHz and 1.40 V nearly all the
# time. At 85% it settles around 1008-1200 MHz (1.175-1.275 V) for the same work and still
# rises when more is asked of it.
After=armbian-hardware-optimize.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'echo 85 > /sys/devices/system/cpu/cpufreq/ondemand/up_threshold'

[Install]
WantedBy=multi-user.target
